<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- Sets compiler target framework to .NET 4.8 and disables debug mode for production -->
    <compilation debug="false" targetFramework="4.8"/>

    <!-- Enables .NET 4.8 execution defaults, request limits, and async support -->
    <httpRuntime targetFramework="4.8"/>

    <!-- Renders controls using modern HTML5 standards -->
    <pages controlRenderingCompatibilityVersion="4.5"/>
  </system.web>

  <system.webServer>
    <!-- Enables integrated pipeline mode features in IIS -->
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true"/>
  </system.webServer>
</configuration>
